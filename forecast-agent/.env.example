OPENROUTER_API_KEY=sk-or-...
SERPER_API_KEY=...
CALIBRATE_LAMBDA=0.85
FORECAST_MODEL=openai/gpt-4o

# --- v3 ensemble (LangGraph; not enabled in main.py until you wire it) ---
# Comma-separated OpenRouter model ids; each runs analyst → Serper → forecaster in parallel
# ENSEMBLE_MODELS=openai/gpt-4o,anthropic/claude-sonnet-4,google/gemini-2.5-flash-preview
# ENSEMBLE_AGGREGATION=median
# ENSEMBLE_MAX_CONCURRENCY=10

# Kalshi public market data (no key required for reads)
KALSHI_BASE_URL=https://api.elections.kalshi.com

# v2 market prior: if |p_model - 0.5| < threshold, use Kalshi price instead
CONFIDENCE_THRESHOLD=0.15
# Optional linear blend: p = (1-w)*model + w*market (0=off, use threshold rule only)
MARKET_PRIOR_WEIGHT=0.0

# Kalshi trading keys (optional — not needed for price reads)
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_B64=
