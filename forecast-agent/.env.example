OPENROUTER_API_KEY=sk-or-...
SERPER_API_KEY=...
CALIBRATE_LAMBDA=0.85
FORECAST_MODEL=openai/gpt-4o

# v3 ensemble (LangGraph) — main.py path when FORECAST_VERSION=v3
FORECAST_VERSION=v3
# Default v3 trio (each paired with paper-recommended prompt; see v3/prompts.py):
#   openai/gpt-4o                 -> superforecaster (DeepSeek-R1 zero-shot, Fig. 4)
#   microsoft/phi-4               -> phi4_scratchpad (Phi-4 7-step, Fig. 4)
#   google/gemini-3.1-flash-lite  -> base_rate
# ENSEMBLE_MODELS=openai/gpt-4o,microsoft/phi-4,google/gemini-3.1-flash-lite
ANALYST_MODEL=google/gemini-3.1-flash-lite
ENSEMBLE_AGGREGATION=median
ENSEMBLE_MAX_CONCURRENCY=10
# Parallel Serper queries per market
SERPER_MAX_WORKERS=3
# evaluate_v3_local.py: markets in flight (1=sequential, 2-3=faster eval)
EVAL_CONCURRENCY=1
DISAGREEMENT_THRESHOLD=0.25
DISAGREEMENT_SHRINK_STRENGTH=0.5
DISAGREEMENT_MARKET_WEIGHT=0.35

# Kalshi public market data (no key required for reads)
KALSHI_BASE_URL=https://api.elections.kalshi.com

# Market prior: if |p_model - 0.5| < threshold, use Kalshi price instead
CONFIDENCE_THRESHOLD=0.15
MARKET_PRIOR_WEIGHT=0.0

# Kalshi trading keys (optional — not needed for price reads)
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_B64=
